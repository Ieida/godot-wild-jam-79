[sub_resource type="GDScript" id="GDScript_4haeq"]
resource_name = "cloud_movement"
script/source = "extends Parallax2D

@export var CLOUD_SPEED: float = 5
@export var variation: bool

func _process(delta: float) -> void:
	if variation:
		var st = Time.get_unix_time_from_system()
		var t = maxf(.2, (1. + sin(st * .1)) / 2.)
		var t2 = maxf(.2, (1. + sin(st * .05)) / 2.)
		var ft = t * t2
		self.scroll_offset.x += ft * CLOUD_SPEED * delta
	else:
		self.scroll_offset.x += CLOUD_SPEED * delta
"

