[sub_resource type="GDScript" id="GDScript_tucxw"]
resource_name = "prototype_level"
script/source = "extends Level


@onready var game: Game = get_node(^\"/root/Game\")


func _on_central_tree_withered():
	var go = game.menus[&\"game_over\"] as GameOver
	go.open()


func _ready() -> void:
	%CentralTree.hitbox.depleted.connect(_on_central_tree_withered)
"

